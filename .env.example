# Copia este archivo a .env y rellena los valores reales. .env no se sube al repo.

# Cadena de conexión "pooler" a Postgres — la usa la app en tiempo de
# ejecución. Con Supabase: pestaña Connect → ORM, la que va por el puerto
# 6543 (Supavisor / transaction pooler).
DATABASE_URL="postgresql://user:password@localhost:5432/soluciones?schema=public"

# Conexión directa, sin pooler — la usan las migraciones de Prisma
# (`pnpm db:migrate`). Con Supabase: la misma pantalla, puerto 5432.
# Si tu Postgres no tiene pooler, pon aquí el mismo valor que DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/soluciones?schema=public"

# Genera uno con: npx auth secret
AUTH_SECRET=""
