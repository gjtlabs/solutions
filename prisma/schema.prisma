// Esquema de datos de Soluciones — ver el documento de arquitectura para el
// contexto de cada módulo. Multi-local desde el día uno (Local es la raíz de
// casi todo) aunque la v1 solo gestione un bar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cuenta, locales y roles
// ---------------------------------------------------------------------------

enum Rol {
  ADMIN
  ENCARGADO
  CAMARERO
  COCINA
  GESTORIA
}

model Local {
  id          String   @id @default(cuid())
  nombre      String
  direccion   String?
  zonaHoraria String   @default("Europe/Madrid")
  createdAt   DateTime @default(now())
  // Formato de pantalla del TPV — ancho máximo de TODA la página (no del
  // lienzo del plano, que tiene su propio alto ajustable más abajo).
  planoFormato FormatoPlano @default(PANORAMICO_16_9)
  // Alto del lienzo del plano de sala, en px — el ancho ya es fluido, pero
  // el alto se deja ajustar a mano arrastrando la esquina.
  planoAlto    Int          @default(560)
  // Apariencia: tema claro/oscuro y color de acento de los botones — ver
  // Ajustes.
  tema         TemaColor    @default(CLARO)
  colorMarca   ColorMarca   @default(VERDE)

  membresias     Membresia[]
  zonas          Zona[]
  mesas          Mesa[]
  elementosPlano ElementoPlano[]
  reservas       Reserva[]
  categorias   CategoriaCarta[]
  productos    Producto[]
  ingredientes Ingrediente[]
  proveedores  Proveedor[]
  reposiciones Reposicion[]
  empleados    Empleado[]
  cierresCaja  CierreCaja[]

  @@map("locales")
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  pin          String? // PIN rápido de 4 dígitos para entrar al TPV en sala
  createdAt    DateTime @default(now())

  membresias Membresia[]
  empleado   Empleado?
  comandas   Comanda[]

  @@map("usuarios")
}

// Un usuario puede tener acceso a varios locales, con un rol distinto en cada uno.
model Membresia {
  id        String @id @default(cuid())
  usuarioId String
  localId   String
  rol       Rol

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  local   Local   @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, localId])
  @@map("membresias")
}

// ---------------------------------------------------------------------------
// TPV y ventas
// ---------------------------------------------------------------------------

enum EstadoComanda {
  ABIERTA
  ENVIADA
  COBRADA
}

enum EstadoLineaComanda {
  PENDIENTE
  COCINA
  SERVIDO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  OTRO
}

enum FormaMesa {
  REDONDA
  RECTANGULAR
}

enum FormatoPlano {
  PANORAMICO_16_9
  ESTANDAR_4_3
}

enum TemaColor {
  CLARO
  OSCURO
}

enum ColorMarca {
  VERDE
  AZUL
  TERRACOTA
  GRANATE
  PIZARRA
}

// Compartido entre Producto (lo que se vende) e Ingrediente (lo que se
// compra y almacena) — CONSUMIBLE cubre lo que no es ni comida ni bebida
// pero sigue siendo inventario (servilletas, vasos de un solo uso,
// productos de limpieza...).
enum TipoItem {
  COMIDA
  BEBIDA
  CONSUMIBLE
}

// Espacio físico del local (Terraza, Interior, Barra...). Cada una tiene su
// propio lienzo en el plano del TPV. Renombrar una zona no toca las mesas
// que contiene — solo cuelgan de su id, no de un texto suelto.
model Zona {
  id      String @id @default(cuid())
  localId String
  nombre  String
  orden   Int    @default(0)
  // Forma libre: lista de vértices [{x,y}, ...] en % del lienzo del local
  // (0-100), en el orden en que se dibujan. Mínimo 3 puntos. Todo en
  // porcentaje — a diferencia de una mesa, una sala dibujada a mano no
  // tiene un tamaño físico fijo que conservar en píxeles.
  puntos Json
  // Token de color de la paleta fija — ver tokens.md de la skill
  // design-system. Nunca un hex libre, para no salirse de la paleta.
  color String @default("neutro")

  local Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  mesas Mesa[]

  @@unique([localId, nombre])
  @@map("zonas")
}

model Mesa {
  id         String    @id @default(cuid())
  localId    String
  zonaId     String
  numero     String
  capacidad  Int       @default(2)
  // Posición en el plano: porcentaje (0-100) del ancho/alto del lienzo de
  // su zona — así el plano se adapta a cualquier tamaño de pantalla.
  posicionX  Float     @default(50)
  posicionY  Float     @default(50)
  // Tamaño en píxeles: el tamaño físico de una mesa no debería depender
  // del ancho de la pantalla, así que esto NO es porcentaje.
  forma      FormaMesa @default(RECTANGULAR)
  ancho      Int       @default(90)
  alto       Int       @default(90)

  local     Local      @relation(fields: [localId], references: [id], onDelete: Cascade)
  zona      Zona       @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  comandas  Comanda[]
  reservas  Reserva[]

  @@unique([zonaId, numero])
  @@map("mesas")
}

enum TipoElemento {
  PUERTA
  ESCALERA
  PARED
}

// Elementos estructurales del plano (puertas, escaleras, paredes) — solo
// decoran/orientan, no tienen comportamiento de negocio. Cuelgan del local
// directamente, no de una zona, porque una puerta o una pared suele estar
// justo en el límite entre dos.
model ElementoPlano {
  id        String       @id @default(cuid())
  localId   String
  tipo      TipoElemento
  // Igual que Zona/Mesa: posición en % del lienzo del local, tamaño en
  // píxeles, más una rotación en cuartos de vuelta (0/90/180/270).
  posicionX Float        @default(50)
  posicionY Float        @default(50)
  ancho     Int          @default(60)
  alto      Int          @default(20)
  rotacion  Int          @default(0)

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@map("elementos_plano")
}

model Comanda {
  id            String        @id @default(cuid())
  mesaId        String
  camareroId    String
  estado        EstadoComanda @default(ABIERTA)
  horaApertura  DateTime      @default(now())
  horaCierre    DateTime?

  mesa     Mesa            @relation(fields: [mesaId], references: [id])
  camarero Usuario         @relation(fields: [camareroId], references: [id])
  lineas   LineaComanda[]
  ticket   Ticket?

  @@map("comandas")
}

model LineaComanda {
  id         String              @id @default(cuid())
  comandaId  String
  productoId String
  cantidad   Int                 @default(1)
  notas      String?
  estado     EstadoLineaComanda  @default(PENDIENTE)
  // Momento en que pasó a cocina (estado PENDIENTE -> COCINA) — de aquí
  // sale el aviso de "lleva más de 20 minutos sin salir". Vacío mientras
  // sigue pendiente de enviar.
  horaEnviada DateTime?

  comanda  Comanda  @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("lineas_comanda")
}

model Ticket {
  id          String     @id @default(cuid())
  comandaId   String     @unique
  cierreCajaId String?
  total       Decimal    @db.Decimal(10, 2)
  metodoPago  MetodoPago
  fecha       DateTime   @default(now())

  comanda    Comanda     @relation(fields: [comandaId], references: [id])
  cierreCaja CierreCaja? @relation(fields: [cierreCajaId], references: [id])

  @@map("tickets")
}

model CierreCaja {
  id             String   @id @default(cuid())
  localId        String
  fecha          DateTime @default(now())
  totalEsperado  Decimal  @db.Decimal(10, 2)
  totalContado   Decimal  @db.Decimal(10, 2)
  diferencia     Decimal  @db.Decimal(10, 2)

  local   Local    @relation(fields: [localId], references: [id])
  tickets Ticket[]

  @@map("cierres_caja")
}

// Reserva de mesa. La mesa es opcional (se puede reservar "para 4 personas
// a las 21:00" sin asignar mesa todavía, y decidirlo al llegar el cliente).
model Reserva {
  id       String    @id @default(cuid())
  localId  String
  nombre   String
  telefono String?
  personas Int
  hora     DateTime
  mesaId   String?
  notas    String?
  createdAt DateTime @default(now())

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)
  mesa  Mesa? @relation(fields: [mesaId], references: [id], onDelete: SetNull)

  @@map("reservas")
}

// ---------------------------------------------------------------------------
// Carta y escandallo
// ---------------------------------------------------------------------------

model CategoriaCarta {
  id      String @id @default(cuid())
  localId String
  nombre  String
  orden   Int    @default(0)

  local     Local      @relation(fields: [localId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@map("categorias_carta")
}

model Producto {
  id              String       @id @default(cuid())
  localId         String
  categoriaId     String
  nombre          String
  precioVenta     Decimal      @db.Decimal(10, 2)
  visibleEnCarta  Boolean      @default(true)
  alergenos       String[]     @default([])
  // Distingue comida de bebida para el panel de servicio (bebidas/comidas
  // servidas, aviso de comida tardía) sin depender de cómo se llame la
  // categoría — la gestión completa de categorías es de Fase 2.
  tipo            TipoItem @default(COMIDA)

  local          Local            @relation(fields: [localId], references: [id], onDelete: Cascade)
  categoria      CategoriaCarta   @relation(fields: [categoriaId], references: [id])
  lineasComanda  LineaComanda[]
  receta         RecetaLinea[]

  @@map("productos")
}

// Una línea de receta = un ingrediente y su cantidad dentro del escandallo
// de un producto. El coste y margen se calculan a partir del coste unitario
// vigente de cada ingrediente, no se persisten aquí para no desincronizarse.
model RecetaLinea {
  id            String  @id @default(cuid())
  productoId    String
  ingredienteId String
  cantidad      Decimal @db.Decimal(10, 3)

  producto    Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@unique([productoId, ingredienteId])
  @@map("receta_lineas")
}

// ---------------------------------------------------------------------------
// Inventario y proveedores
// ---------------------------------------------------------------------------

enum TipoMovimientoStock {
  ENTRADA // recepción de proveedor -> almacén
  SALIDA // venta cobrada -> descuenta de barra, vía escandallo
  MERMA // corrección manual (rotura, caducidad...)
  TRASPASO // reposición: almacén -> barra, no cambia el total del local
}

enum EstadoPedidoProveedor {
  BORRADOR
  ENVIADO
  RECIBIDO
}

enum EstadoReposicion {
  PENDIENTE
  COMPLETADA
}

model Ingrediente {
  id           String   @id @default(cuid())
  localId      String
  nombre       String
  tipo         TipoItem @default(CONSUMIBLE)
  unidadMedida String // kg, l, unidad...
  // El mismo ingrediente vive partido en dos sitios: el grueso en almacén,
  // y una cantidad pequeña "a mano" en barra/sala para servir sin ir de
  // cámara en cámara. Una venta cobrada descuenta de stockBarra (vía
  // escandallo); una recepción de proveedor entra en stockAlmacen; la
  // reposición mueve de uno a otro.
  stockAlmacen     Decimal @db.Decimal(10, 3) @default(0)
  stockBarra       Decimal @db.Decimal(10, 3) @default(0)
  // Par de picking en barra: por debajo del mínimo, la reposición diaria
  // sugiere rellenar hasta el máximo (si el almacén tiene suficiente).
  stockMinimoBarra Decimal @db.Decimal(10, 3) @default(0)
  stockMaximoBarra Decimal @db.Decimal(10, 3) @default(0)
  costeUnitario    Decimal @db.Decimal(10, 4) @default(0)

  local             Local                  @relation(fields: [localId], references: [id], onDelete: Cascade)
  recetaLineas      RecetaLinea[]
  movimientos       MovimientoStock[]
  lineasPedido      PedidoProveedorLinea[]
  lineasRecepcion   RecepcionLinea[]
  lineasReposicion  ReposicionLinea[]

  @@map("ingredientes")
}

model MovimientoStock {
  id            String              @id @default(cuid())
  ingredienteId String
  tipo          TipoMovimientoStock
  cantidad      Decimal             @db.Decimal(10, 3)
  fecha         DateTime            @default(now())
  referencia    String? // p. ej. id de Recepcion o de Comanda que originó el movimiento

  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@map("movimientos_stock")
}

model Proveedor {
  id                 String  @id @default(cuid())
  localId            String
  nombre             String
  contacto           String?
  productosHabituales String?

  local   Local              @relation(fields: [localId], references: [id], onDelete: Cascade)
  pedidos PedidoProveedor[]

  @@map("proveedores")
}

model PedidoProveedor {
  id          String                 @id @default(cuid())
  proveedorId String
  fecha       DateTime               @default(now())
  estado      EstadoPedidoProveedor  @default(BORRADOR)

  proveedor Proveedor              @relation(fields: [proveedorId], references: [id])
  lineas    PedidoProveedorLinea[]
  recepcion Recepcion?

  @@map("pedidos_proveedor")
}

model PedidoProveedorLinea {
  id            String  @id @default(cuid())
  pedidoId      String
  ingredienteId String
  cantidad      Decimal @db.Decimal(10, 3)
  // Lo que se espera pagar por unidad al hacer el pedido — puede diferir de
  // lo que se acabe pagando de verdad al recibir el albarán (RecepcionLinea).
  precioUnitario Decimal @db.Decimal(10, 4) @default(0)

  pedido      PedidoProveedor @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente     @relation(fields: [ingredienteId], references: [id])

  // Añadir dos veces la misma referencia a un pedido sencillamente suma la
  // cantidad — nunca una segunda línea duplicada para el mismo ingrediente.
  @@unique([pedidoId, ingredienteId])
  @@map("pedidos_proveedor_lineas")
}

model Recepcion {
  id            String   @id @default(cuid())
  pedidoId      String   @unique
  fecha         DateTime @default(now())
  // Número del albarán físico del proveedor, para poder cotejarlo luego.
  numeroAlbaran String?
  incidencias   String?

  pedido PedidoProveedor    @relation(fields: [pedidoId], references: [id])
  lineas RecepcionLinea[]

  @@map("recepciones")
}

model RecepcionLinea {
  id                String  @id @default(cuid())
  recepcionId       String
  ingredienteId     String
  cantidadRecibida  Decimal @db.Decimal(10, 3)
  // Lo que de verdad cobra el proveedor por unidad en este albarán — al
  // confirmar la recepción, este es el valor que pasa a ser el Coste del
  // ingrediente en Inventario (el precio real más reciente, no uno suelto).
  precioUnitario    Decimal @db.Decimal(10, 4) @default(0)

  recepcion   Recepcion   @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@map("recepcion_lineas")
}

// La reposición diaria: al cerrar la última mesa de la jornada (o a mano,
// con el botón "Generar ahora"), se calcula qué referencias han caído por
// debajo de su mínimo en barra y cuánto llevar de almacén para rellenar
// hasta el máximo. El camarero la marca hecha línea a línea; al completarla
// se traspasa de verdad el stock (almacén -> barra).
model Reposicion {
  id      String           @id @default(cuid())
  localId String
  fecha   DateTime         @default(now())
  estado  EstadoReposicion @default(PENDIENTE)

  local  Local              @relation(fields: [localId], references: [id], onDelete: Cascade)
  lineas ReposicionLinea[]

  @@map("reposiciones")
}

model ReposicionLinea {
  id                String  @id @default(cuid())
  reposicionId      String
  ingredienteId     String
  cantidadSugerida  Decimal @db.Decimal(10, 3)
  cantidadLlevada   Decimal @db.Decimal(10, 3) @default(0)
  completada        Boolean @default(false)

  reposicion  Reposicion  @relation(fields: [reposicionId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@map("reposicion_lineas")
}

// ---------------------------------------------------------------------------
// Equipo y gestoría
// ---------------------------------------------------------------------------

enum EstadoNomina {
  PENDIENTE
  PAGADA
}

model Empleado {
  id             String  @id @default(cuid())
  usuarioId      String  @unique
  localId        String
  dniNie         String  @unique
  iban           String?
  tipoContrato   String
  salarioBase    Decimal @db.Decimal(10, 2)

  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  local   Local    @relation(fields: [localId], references: [id])
  turnos  Turno[]
  nominas Nomina[]

  @@map("empleados")
}

model Turno {
  id           String    @id @default(cuid())
  empleadoId   String
  horaEntrada  DateTime
  horaSalida   DateTime?

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@map("turnos")
}

model Nomina {
  id           String       @id @default(cuid())
  empleadoId   String
  periodo      String // "2026-08"
  bruto        Decimal      @db.Decimal(10, 2)
  deducciones  Decimal      @db.Decimal(10, 2)
  neto         Decimal      @db.Decimal(10, 2)
  estado       EstadoNomina @default(PENDIENTE)

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@unique([empleadoId, periodo])
  @@map("nominas")
}
